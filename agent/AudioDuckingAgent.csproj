<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>assets\chatduck.ico</ApplicationIcon>
    <AssemblyName>ChatGPTAudioDuckingAgent</AssemblyName>
    <AssemblyTitle>ChatDuck Windows Agent</AssemblyTitle>
    <Product>ChatDuck</Product>
    <Company>ChatDuck contributors</Company>
    <Version>2.8.9</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>2.8.9.0</AssemblyVersion>
    <FileVersion>2.8.9.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="SourceRevisionId" Value="$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
    <Using Include="System.IO" />
    <InternalsVisibleTo Include="ChatDuckAgent.RegressionTests" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
  </ItemGroup>
</Project>
