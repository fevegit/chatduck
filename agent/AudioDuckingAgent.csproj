<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>ChatGPTAudioDuckingAgent</AssemblyName>
    <AssemblyTitle>ChatDuck Windows Agent</AssemblyTitle>
    <Product>ChatDuck</Product>
    <Company>ChatDuck contributors</Company>
    <Version>2.7.6-beta.1</Version>
    <InformationalVersion>2.7.6-beta.1</InformationalVersion>
    <AssemblyVersion>2.7.6.0</AssemblyVersion>
    <FileVersion>2.7.6.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
  </ItemGroup>
</Project>
